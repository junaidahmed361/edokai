{
  "name": "edokai",
  "productName": "Edokai",
  "version": "3.1.0",
  "description": "Edokai \u2014 gamified ML learning: concept worlds, TorchLeet dojo with live Python REPL, Wilds RL environments, self-improving coach",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dkg:sync": "node scripts/sync-dkg-supabase.mjs",
    "dkg:test": "node scripts/test-dkg-adapter.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "better-sqlite3": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ai.edokai.app",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/node_modules/better-sqlite3/deps/**",
      "!**/*.map"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "afterPack": "scripts/sign-mac-ad-hoc.cjs"
  }
}
